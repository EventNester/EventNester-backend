generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ATTENDEE
  STAFF
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketCodeStatus {
  UNUSED
  USED
  REVOKED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CheckInResult {
  VALID
  DUPLICATE
  INVALID
  EXPIRED
  WRONG_EVENT
  REVOKED
  NOT_AUTHORIZED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum RegistrationMode {
  PUBLIC_LINK
  CLOSED_IMPORT
  HYBRID
}

enum RegistrationSource {
  IMPORT
  PUBLIC_LINK
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  email           String      @unique
  passwordHash    String      @map("password_hash")
  phone           String?
  role            UserRole    @default(ATTENDEE)
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?   @map("email_verified_at")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  events             Event[]
  staffAssignments   EventStaffAssignment[]
  payments           Payment[]
  auditLogs          AuditLog[]
  checkins           CheckIn[]
  notifications      Notification[]
  importBatches      ImportBatch[]

  @@map("users")
}

model Event {
  id                     String           @id @default(dbgenerated("gen_random_uuid()"))
  title                  String
  description            String?
  venue                  String?
  slug                   String           @unique
  startTime              DateTime         @map("start_time")
  endTime                DateTime         @map("end_time")
  status                 EventStatus      @default(DRAFT)
  ownerId                String           @map("owner_id")
  registrationMode       RegistrationMode @default(PUBLIC_LINK)
  isPaid                 Boolean          @default(false)
  capacity               Int?
  currency               String           @default("NGN")
  registrationOpensAt    DateTime?        @map("registration_opens_at")
  registrationClosesAt   DateTime?        @map("registration_closes_at")
  publishedAt            DateTime?        @map("published_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  deletedAt              DateTime?        @map("deleted_at")

  owner              User                   @relation(fields: [ownerId], references: [id])
  staffAssignments   EventStaffAssignment[]
  ticketTypes        TicketType[]
  ticketCodes        TicketCode[]
  importBatches      ImportBatch[]
  registrations      Registration[]
  checkins           CheckIn[]
  payments           Payment[]
  invoices           Invoice[]
  notifications      Notification[]

  @@index([ownerId])
  @@index([status])
  @@index([slug])
  @@map("events")
}

model EventStaffAssignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId         String   @map("event_id")
  userId          String   @map("user_id")
  permissionScope String?  @map("permission_scope")
  active          Boolean  @default(true)
  assignedAt      DateTime @default(now()) @map("assigned_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_staff_assignments")
}

model TicketType {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId      String   @map("event_id")
  name         String
  description  String?
  price        Int      @default(0)
  capacity     Int?
  quantitySold Int      @default(0) @map("quantity_sold")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  event         Event          @relation(fields: [eventId], references: [id])
  registrations Registration[]

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("ticket_types")
}

model TicketCode {
  id            String           @id @default(dbgenerated("gen_random_uuid()"))
  eventId       String           @map("event_id")
  code          String
  status        TicketCodeStatus @default(UNUSED)
  usedAt        DateTime?        @map("used_at")
  attendeeEmail String?          @map("attendee_email")
  attendeeName  String?          @map("attendee_name")
  createdAt     DateTime         @default(now()) @map("created_at")

  event        Event          @relation(fields: [eventId], references: [id])
  registration Registration?

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
  @@map("ticket_codes")
}

model Registration {
  id               String             @id @default(dbgenerated("gen_random_uuid()"))
  eventId          String             @map("event_id")
  ticketCodeId     String             @unique @map("ticket_code_id")
  attendeeEmail    String             @map("attendee_email")
  attendeeName     String             @map("attendee_name")
  phone            String?
  ticketTypeId     String?            @map("ticket_type_id")
  paymentStatus    PaymentStatus      @default(PENDING)
  source           RegistrationSource @default(PUBLIC_LINK)
  confirmationCode String?            @unique @map("confirmation_code")
  metadata         Json?
  qrIssued         Boolean            @default(false) @map("qr_issued")
  qrIssuedAt       DateTime?          @map("qr_issued_at")
  status           RegistrationStatus @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id])
  ticketCode TicketCode @relation(fields: [ticketCodeId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  qrToken       QrToken?
  checkins      CheckIn[]
  payment       Payment?
  notifications Notification[]

  @@unique([eventId, attendeeEmail])
  @@index([eventId])
  @@index([attendeeEmail])
  @@map("registrations")
}

model QrToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  registrationId String    @unique @map("registration_id")
  tokenHash      String    @unique @map("token_hash")
  tokenCipher    String?   @map("token_cipher")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  scanCount      Int       @default(0) @map("scan_count")

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([tokenHash])
  @@map("qr_tokens")
}

model CheckIn {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String        @map("event_id")
  registrationId String        @map("registration_id")
  staffId        String        @map("staff_id")
  scannedAt      DateTime      @default(now()) @map("scanned_at")
  result         CheckInResult
  deviceInfo     String?       @map("device_info")
  ipAddress      String?       @map("ip_address")
  deletedAt      DateTime?     @map("deleted_at")

  event        Event        @relation(fields: [eventId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])
  staff        User         @relation(fields: [staffId], references: [id])

  @@unique([eventId, registrationId])
  @@index([eventId])
  @@index([registrationId])
  @@map("check_ins")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId           String        @map("event_id")
  userId            String        @map("user_id")
  registrationId    String?       @unique @map("registration_id")
  paystackReference String        @unique @map("paystack_reference")
  amount            Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  gateway           String        @default("PAYSTACK")
  metadata          Json?
  verifiedAt        DateTime?     @map("verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  paidAt            DateTime?     @map("paid_at")

  event        Event         @relation(fields: [eventId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  invoice      Invoice?

  @@index([eventId])
  @@index([userId])
  @@index([paystackReference])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId       String        @map("event_id")
  paymentId     String        @unique @map("payment_id")
  invoiceNumber String        @unique @map("invoice_number")
  amount        Int
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(PENDING)

  event   Event   @relation(fields: [eventId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([eventId])
  @@map("invoices")
}

model Notification {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  recipient         String
  channel           String
  template          String
  subject           String?
  context           Json?
  status            NotificationStatus @default(PENDING)
  userId            String?            @map("user_id")
  eventId           String?            @map("event_id")
  registrationId    String?            @map("registration_id")
  providerMessageId String?            @map("provider_message_id")
  failureReason     String?            @map("failure_reason")
  sentAt            DateTime?          @map("sent_at")
  readAt            DateTime?          @map("read_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@index([recipient])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  actorId        String?  @map("actor_id")
  action         String
  entity         String
  entityId       String   @map("entity_id")
  beforeSnapshot Json?    @map("before_snapshot")
  afterSnapshot  Json?    @map("after_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ImportBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  eventId          String    @map("event_id")
  uploadedById     String    @map("uploaded_by_id")
  originalFilename String    @map("original_filename")
  fileType         String    @map("file_type")
  totalRows        Int       @default(0) @map("total_rows")
  successRows      Int       @default(0) @map("success_rows")
  failedRows       Int       @default(0) @map("failed_rows")
  status           String    @default("PROCESSING")
  errorReport      Json?     @map("error_report")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  event      Event @relation(fields: [eventId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([eventId])
  @@map("import_batches")
}
