              "valid": { "type": "integer" },
              "duplicate": { "type": "integer" }
            }
          },
          "noShows": { "type": "integer" },
          "capacity": {
            "type": "object",
            "properties": {
              "max": { "type": "integer", "nullable": true },
              "utilization": { "type": "integer", "nullable": true }
            }
          },
          "ticketBreakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ticketType": { "type": "string" },
                "sold": { "type": "integer" },
                "checkedIn": { "type": "integer" }
              }
            }
          }
        }
      },
      "CheckIn": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "registrationId": {
            "type": "string"
          },
          "staffId": {
            "type": "string"
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": ["VALID", "DUPLICATE", "INVALID"]
          },
          "deviceInfo": {
            "type": "string"
          },
          "ipAddress": {
            "type": "string"
          },
          "registration": {
            "type": "object",
            "properties": {
              "attendeeName": { "type": "string" },
              "attendeeEmail": { "type": "string" }
            }
          },
          "staff": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      },
      "CheckInListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CheckIn" }
          }
        }
      },

      "TicketCode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "code": { "type": "string" },
          "status": { "type": "string", "enum": ["UNUSED", "USED", "REVOKED"] },
