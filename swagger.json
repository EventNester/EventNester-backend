{
  "openapi": "3.0.0",
  "info": {
    "title": "QPass API",
    "version": "1.0.0",
    "description": "QR Code-Based Event Attendance & Ticket Verification System API.\n\n## Authentication\nMost endpoints require a JWT bearer token. Get one via `/api/v1/auth/login`,\nthen click **Authorize** at the top and paste only the raw token without the `Bearer ` prefix (Swagger UI adds it automatically).\n\n## Conventions\n- All responses follow `{ status, message?, data }`\n- Errors use standard HTTP status codes (400, 401, 403, 404, 409, 422, 500)\n- Timestamps are ISO-8601 strings",
    "contact": {
      "name": "QPass Team",
      "email": "support@qpass.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health & readiness"
    },
    {
      "name": "Auth",
      "description": "Registration, login, refresh, logout, password reset"
    },
    {
      "name": "Events",
      "description": "Event management: CRUD, publish, cancel"
    },
    {
      "name": "Ticket Types",
      "description": "Ticket categories per event"
    },
    {
      "name": "Registrations",
      "description": "Public event view and free self-registration"
    },
    {
      "name": "Import",
      "description": "Attendee import from CSV/XLSX/PDF/DOCX files with batch tracking"
    },
    {
      "name": "Tickets",
      "description": "Ticket listing, detail, PDF download and export"
    },
    {
      "name": "Staff",
      "description": "Event staff assignment and management"
    },
    {
      "name": "Checkins",
      "description": "QR scanning and attendance tracking"
    },
    {
      "name": "Reports",
      "description": "Dashboard statistics and CSV/PDF data exports"
    },
    {
      "name": "Admin",
      "description": "Administrative operations: audit log access"
    }
  ],  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token from /auth/login"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Current 1-indexed page"
          },
          "limit": {
            "type": "integer",
            "description": "Items per page"
          },
          "total": {
            "type": "integer",
            "description": "Total number of matching records"
          },
          "totalPages": {
            "type": "integer",
            "description": "Total number of pages"
          }
        }
      },

      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "User's full name (required, must not be empty)",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Valid email address (required)",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password",
            "description": "Password must be at least 8 characters and contain at least one uppercase letter, one lowercase letter, and one number (required)",
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Valid email address (required)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Account password (required, must not be empty)"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token obtained from login/register (required, must not be empty)"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token to blacklist (required, must not be empty)"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address associated with the account (required, must be valid)"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "password"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Password reset token received via email (required, must not be empty)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "description": "New password — must be at least 8 characters and contain at least one uppercase letter, one lowercase letter, and one number (required)",
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "description": "Current password (required)"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "description": "New password - must be at least 8 characters and contain at least one uppercase letter, one lowercase letter, and one number (required)",
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Full name (optional)"
          },
          "phone": {
            "type": "string",
            "pattern": "^(?:\\+?[0-9]{7,15})?$",
            "description": "Phone number (optional, empty string allowed to clear it)"          }
        }
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["ATTENDEE", "STAFF", "ORGANIZER", "ADMIN"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE", "SUSPENDED"]
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Phone number, if set"
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the email was verified, null if not verified"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT for the Authorization header"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived JWT used to mint new access tokens"
          },
          "expiresIn": {
            "type": "string",
            "example": "30m"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": ["user", "accessToken", "refreshToken"],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              },
              "accessToken": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              },
              "expiresIn": {
                "type": "string"
              }
            }
          }
        }
      },

      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "Public URL slug, generated on publish"
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PUBLISHED", "ACTIVE", "COMPLETED", "CANCELLED"]
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"]
          },
          "isPaid": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Event" }
        }
      },
      "EventListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Event" }
              },
              "pagination": { "$ref": "#/components/schemas/Pagination" }
            }
          }
        }
      },
      "EventCreateRequest": {
        "type": "object",
        "required": ["title", "startTime", "endTime", "registrationMode"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Event title (required, 1-200 characters)"
          },
          "description": {
            "type": "string",
            "description": "Optional event description"
          },
          "venue": {
            "type": "string",
            "description": "Optional event venue/location"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "Event start time in ISO 8601 format (required, e.g. 2026-08-15T09:00:00Z)"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "Event end time in ISO 8601 format (required, must be after startTime)"
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"],
            "description": "Registration mode (required): PUBLIC_LINK — self-registration via link, CLOSED_IMPORT — admin-imported attendees only, HYBRID — both"
          },
          "isPaid": {
            "type": "boolean",
            "description": "Whether the event requires payment (payment processing deferred to Phase 2)"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of attendees (optional)"
          },
          "currency": {
            "type": "string",
            "description": "Currency code for paid events (e.g. NGN, USD)"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time",
            "description": "When registration opens (ISO 8601)"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time",
            "description": "When registration closes (ISO 8601)"
          }
        }
      },
      "EventUpdateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Event title (optional, 1-200 characters if provided)"
          },
          "description": {
            "type": "string",
            "description": "Optional event description"
          },
          "venue": {
            "type": "string",
            "description": "Optional event venue/location"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "Event start time (ISO 8601). If provided, endTime is also required."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "Event end time (ISO 8601). If provided, startTime is also required. Must be after startTime when both are set."
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"],
            "description": "Registration mode: PUBLIC_LINK, CLOSED_IMPORT, or HYBRID"
          },
          "isPaid": {
            "type": "boolean",
            "description": "Whether the event requires payment"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of attendees"
          },
          "currency": {
            "type": "string",
            "description": "Currency code for paid events (e.g. NGN, USD)"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time",
            "description": "When registration opens (ISO 8601)"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time",
            "description": "When registration closes (ISO 8601)"
          }
        }
      },

      "TicketType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          },
          "quantitySold": {
            "type": "integer",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "sortOrder": {
            "type": "integer",
            "default": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketTypeCreateRequest": {
        "type": "object",
        "required": ["name", "price", "capacity"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "TicketTypeUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        }
      },

      "PublicEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PUBLISHED", "ACTIVE", "COMPLETED", "CANCELLED"]
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"]
          },
          "isPaid": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          },
          "ticketTypes": {
            "type": "array",
            "description": "Active ticket types ordered by sort order",
            "items": { "$ref": "#/components/schemas/TicketType" }
          }
        }
      },
      "PublicEventResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/PublicEvent" }
        }
      },
      "FreeRegistrationRequest": {
        "type": "object",
        "required": ["slug", "name", "email"],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Public event slug"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Attendee name (required)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Attendee email (required)"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "description": "Optional phone number"
          },
          "ticketTypeId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional free ticket type (paid ticket types rejected)"
          },
          "metadata": {
            "type": "object",
            "description": "Optional custom metadata"
          }
        }
      },
      "QrPayload": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Raw opaque QR token delivered to the attendee"
          },
          "image": {
            "type": "string",
            "format": "byte",
            "description": "Base64 PNG data URL of the QR code"
          }
        }
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "ticketCodeId": {
            "type": "string"
          },
          "attendeeEmail": {
            "type": "string"
          },
          "attendeeName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "ticketTypeId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "CONFIRMED", "CANCELLED"]
          },
          "paymentStatus": {
            "type": "string",
            "enum": ["PENDING", "SUCCESS", "FAILED", "REFUNDED"]
          },
          "source": {
            "type": "string",
            "enum": ["IMPORT", "PUBLIC_LINK"]
          },
          "confirmationCode": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "qrIssued": {
            "type": "boolean"
          },
          "qrIssuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistrationCreateRequest": {
        "type": "object",
        "required": ["attendeeName", "attendeeEmail"],
        "properties": {
          "attendeeName": {
            "type": "string"
          },
          "attendeeEmail": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "ticketTypeId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["IMPORT", "PUBLIC_LINK"]
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "RegistrationResult": {
        "type": "object",
        "properties": {
          "registration": {
            "$ref": "#/components/schemas/Registration"
          },
          "qr": {
            "$ref": "#/components/schemas/QrPayload"
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/RegistrationResult" }
        }
      },

      "ImportError": {
        "type": "object",
        "properties": {
          "row": {
            "type": "integer",
            "description": "1-indexed row number in the source file"
          },
          "email": {
            "type": "string",
            "description": "Affected attendee email, when applicable"
          },
          "error": {
            "type": "string",
            "description": "Human-readable error for the row"
          }
        }
      },
      "ImportBatch": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "uploadedById": { "type": "string" },
          "originalFilename": { "type": "string" },
          "fileType": {
            "type": "string",
            "enum": ["csv", "xlsx", "pdf", "docx", "text/csv", "application/pdf"]
          },
          "status": {
            "type": "string",
            "enum": ["PROCESSING", "COMPLETED", "FAILED"]
          },
          "totalRows": { "type": "integer" },
          "successRows": { "type": "integer" },
          "failedRows": { "type": "integer" },
          "errorReport": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ImportError" }
          },
          "completedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ImportSummary": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PROCESSING", "COMPLETED", "FAILED"]
          },
          "totalRows": {
            "type": "integer"
          },
          "successRows": {
            "type": "integer"
          },
          "failedRows": {
            "type": "integer"
          },
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ImportError" }
          }
        }
      },
      "ImportSummaryResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ImportSummary" }
        }
      },
      "ImportBatchListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ImportBatch" }
          }
        }
      },
      "ImportTemplateResponse": {
        "type": "string",
        "format": "binary",
        "description": "Downloaded CSV or PDF template file"
      },

      "Ticket": {
        "type": "object",
        "description": "Registration record enriched with ticket code, ticket type and (for detail views) the opaque scan token and its QR image",
        "allOf": [
          { "$ref": "#/components/schemas/Registration" }
        ],
        "properties": {
          "qr": {
            "type": "object",
            "description": "Gate-scannable QR data. Only present for the event owner, an ADMIN, or the ticket holder (email match). The QR image encodes the raw scan token, never the confirmation code.",
            "properties": {
              "token": {
                "type": "string",
                "nullable": true,
                "description": "Raw opaque QR scan token (64-char hex). Null when unavailable (e.g. already checked-in legacy pass)."
              },
              "image": {
                "type": "string",
                "nullable": true,
                "description": "Base64 PNG data URL encoding qr.token. Null when token is unavailable."
              }
            }
          },
          "qrDataUrl": {
            "type": "string",
            "description": "Base64 PNG data URL of the ticket QR code (encodes the raw scan token). Alias of qr.image."
          },
          "ticketCode": {
            "$ref": "#/components/schemas/TicketCode"
          },
          "ticketType": {
            "$ref": "#/components/schemas/TicketType"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          }
        }
      },
      "TicketDetailResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Ticket" }
        }
      },
      "TicketListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "registrations": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Registration" }
              },
              "pagination": { "$ref": "#/components/schemas/Pagination" }
            }
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "required": ["format"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["csv", "pdf"]
          }
        }
      },

      "StaffAssignmentRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Staff member email. A pending staff user is created if no account exists."
          },
          "permissionScope": {
            "type": "string",
            "description": "Optional permission scope, e.g. check-in-only"
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Event name"
          },
          "venue": {
            "type": "string",
            "nullable": true
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StaffAssignment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "permissionScope": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "assignedAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "StaffAssignmentResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "event": { "$ref": "#/components/schemas/EventSummary" },
              "staff": { "$ref": "#/components/schemas/StaffAssignment" }
            }
          }
        }
      },
      "StaffListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "event": { "$ref": "#/components/schemas/EventSummary" },
              "staff": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/StaffAssignment" }
              }
            }
          }
        }
      },

      "AdminInviteRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email of the person to invite as an admin"
          }
        }
      },
      "AcceptAdminInviteRequest": {
        "type": "object",
        "required": ["name", "password"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The invitee's full name"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "At least 8 characters, with an uppercase letter, lowercase letter, and a number"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "SendOtpRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "VerifyOtpRequest": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string",
            "description": "6-digit verification code",
            "pattern": "^[0-9]{6}$"
          }
        }
      },

      "ScanRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Raw QR token from attendee's QR code (required, must not be empty). Hashed server-side before lookup."
          },
          "deviceInfo": {
            "type": "string",
            "description": "Optional device identifier or name for audit logging"
          }
        }
      },
      "ScanResult": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": ["VALID", "DUPLICATE", "INVALID"]
          },
          "message": {
            "type": "string"
          },
          "attendeeName": {
            "type": "string"
          },
          "checkinId": {
            "type": "string"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "registrations": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "confirmed": { "type": "integer" },
              "pending": { "type": "integer" },
              "cancelled": { "type": "integer" }
            }
          },
          "checkins": {
            "type": "object",
            "properties": {
